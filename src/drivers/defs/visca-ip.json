{
  "format": 1,
  "id": "visca-ip",
  "name": "PTZ カメラ（VISCA over IP）",
  "category": "カメラ",
  "version": "1.1.0",
  "minAppVersion": "0.6.0",
  "transport": "udp",
  "session": "visca-ip",
  "configFields": [
    {
      "id": "host",
      "label": "IP アドレス",
      "type": "text",
      "placeholder": "192.168.0.100",
      "pattern": "^[A-Za-z0-9.:\\-]+$",
      "mono": true
    },
    {
      "id": "port",
      "label": "ポート",
      "type": "number",
      "default": 52381,
      "min": 1,
      "max": 65535
    },
    {
      "id": "framing",
      "label": "頭（ヘッダー）",
      "type": "select",
      "default": "sony",
      "choices": [
        {
          "id": "sony",
          "label": "付ける（Sony 形式・52381）"
        },
        {
          "id": "raw",
          "label": "付けない（VISCA だけ）"
        }
      ],
      "help": "頭を付けないカメラはポートも機種の説明書の番号にします"
    }
  ],
  "actions": [
    {
      "id": "move",
      "name": "パン・チルト",
      "options": [
        {
          "id": "dir",
          "label": "向き",
          "type": "select",
          "default": "up",
          "choices": [
            {
              "id": "up",
              "label": "上"
            },
            {
              "id": "down",
              "label": "下"
            },
            {
              "id": "left",
              "label": "左"
            },
            {
              "id": "right",
              "label": "右"
            },
            {
              "id": "upleft",
              "label": "左上"
            },
            {
              "id": "upright",
              "label": "右上"
            },
            {
              "id": "downleft",
              "label": "左下"
            },
            {
              "id": "downright",
              "label": "右下"
            }
          ]
        },
        {
          "id": "pan",
          "label": "パンの速さ（1–24）",
          "type": "number",
          "default": 8,
          "min": 1,
          "max": 24
        },
        {
          "id": "tilt",
          "label": "チルトの速さ（1–20）",
          "type": "number",
          "default": 8,
          "min": 1,
          "max": 20
        }
      ],
      "send": {
        "kind": "bytes",
        "data": "81 01 06 01 {{option.pan|hexu|pad2}} {{option.tilt|hexu|pad2}} {{option.dir|map}} FF",
        "encoding": "hex"
      },
      "summary": "パン・チルト {{option.dir}}",
      "maps": {
        "dir": {
          "up": "03 01",
          "down": "03 02",
          "left": "01 03",
          "right": "02 03",
          "upleft": "01 01",
          "upright": "02 01",
          "downleft": "01 02",
          "downright": "02 02"
        }
      }
    },
    {
      "id": "stop",
      "name": "パン・チルトを止める",
      "options": [],
      "send": {
        "kind": "bytes",
        "data": "81 01 06 01 01 01 03 03 FF",
        "encoding": "hex"
      }
    },
    {
      "id": "home",
      "name": "ホームへ",
      "options": [],
      "send": {
        "kind": "bytes",
        "data": "81 01 06 04 FF",
        "encoding": "hex"
      }
