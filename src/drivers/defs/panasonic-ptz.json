{
  "format": 1,
  "id": "panasonic-ptz",
  "name": "Panasonic リモートカメラ（AW-HE / AW-UE）",
  "category": "カメラ",
  "version": "1.0.0",
  "minAppVersion": "0.6.0",
  "transport": "http",
  "configFields": [
    {
      "id": "baseUrl",
      "label": "URL の先頭",
      "type": "text",
      "default": "http://192.168.0.10",
      "placeholder": "http://192.168.0.10",
      "pattern": "^https?://.+",
      "mono": true
    }
  ],
