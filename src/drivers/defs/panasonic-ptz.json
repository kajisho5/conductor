        {
          "id": "speed",
          "label": "速さ（1–49）",
          "type": "number",
          "default": 25,
          "min": 1,
          "max": 49,
          "help": "49 がいちばん速い"
        }
      ],
      "send": {
        "kind": "http",
        "method": "GET",
        "path": "/cgi-bin/aw_ptz?cmd=%23PTS{{option.speed|lin:-1:50|pad2}}50&res=1"
      },
      "summary": "左 {{option.speed}}"
