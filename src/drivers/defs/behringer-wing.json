{
  "format": 1,
  "id": "behringer-wing",
  "name": "Behringer WING",
  "category": "ミキサー",
  "version": "1.0.0",
  "minAppVersion": "0.6.0",
  "transport": "osc",
  "configFields": [
    {
      "id": "host",
      "label": "IP アドレス",
      "type": "text",
      "placeholder": "192.168.0.64",
      "pattern": "^[A-Za-z0-9.:\\-]+$",
      "mono": true
    },
    {
      "id": "port",
      "label": "ポート",
      "type": "number",
      "default": 2223,
      "min": 1,
      "max": 65535
    }
  ],
  "actions": [
    {
      "id": "ch_mute",
      "name": "チャンネルのミュート",
      "options": [
        {
          "id": "ch",
          "label": "チャンネル（1–40）",
          "type": "number",
          "default": 1,
          "min": 1,
          "max": 40
        },
        {
          "id": "mute",
          "label": "ミュート",
          "type": "select",
          "default": "1",
          "choices": [
            {
              "id": "1",
              "label": "ミュートする"
            },
            {
              "id": "0",
              "label": "ミュートを外す"
            }
          ]
        }
      ],
      "send": {
        "kind": "osc",
        "address": "/ch/{{option.ch}}/mute",
        "args": [
          {
            "type": "i",
            "value": "{{option.mute}}"
          }
        ]
      },
      "summary": "CH {{option.ch}} mute={{option.mute}}"
    },
    {
      "id": "ch_fader",
      "name": "チャンネルのフェーダー",
      "options": [
        {
          "id": "ch",
          "label": "チャンネル（1–40）",
          "type": "number",
          "default": 1,
          "min": 1,
          "max": 40
        },
        {
          "id": "db",
          "label": "レベル（dB、-144–10）",
          "type": "number",
          "default": 0,
          "min": -144,
          "max": 10
        }
      ],
      "send": {
        "kind": "osc",
        "address": "/ch/{{option.ch}}/fdr",
        "args": [
          {
            "type": "f",
            "value": "{{option.db}}"
          }
