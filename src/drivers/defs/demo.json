{
  "format": 1,
  "id": "demo",
  "name": "デモ機器",
  "category": "デモ",
  "version": "1.0.0",
  "minAppVersion": "0.1.0",
  "transport": "demo",
  "configFields": [
    {
      "id": "model",
      "label": "種類（表示用）",
      "type": "text",
      "default": "デモ"
    },
    {
      "id": "behavior",
      "label": "接続のふるまい",
      "type": "select",
      "default": "ok",
      "choices": [
        {
          "id": "ok",
          "label": "つながる"
        },
        {
          "id": "reconnecting",
          "label": "再接続中のまま"
        },
        {
          "id": "error",
          "label": "エラー"
        }
      ]
    }
  ],
  "actions": [
    {
      "id": "demo.set",
      "name": "値を設定",
      "options": [
        {
          "id": "key",
          "label": "項目",
          "type": "text",
          "mono": true
        },
        {
          "id": "value",
          "label": "値",
          "type": "text"
        }
      ],
      "send": {
        "kind": "builtin",
        "name": "demo.set"
      },
      "summary": "{{option.key}} = {{option.value}}"
    },
    {
      "id": "demo.swap",
      "name": "値を入れ替え",
      "options": [
        {
          "id": "a",
          "label": "項目 1",
          "type": "text",
          "mono": true
        },
        {
          "id": "b",
          "label": "項目 2",
          "type": "text",
          "mono": true
        }
      ],
      "send": {
        "kind": "builtin",
        "name": "demo.swap"
      },
      "summary": "{{option.a}} ⇄ {{option.b}}"
    },
    {
      "id": "demo.toggle",
      "name": "ON / OFF を切り替え",
      "options": [
        {
          "id": "key",
          "label": "項目",
          "type": "text",
          "mono": true
        }
      ],
      "send": {
        "kind": "builtin",
        "name": "demo.toggle"
      },
      "summary": "{{option.key}}"
    }
  ],
  "feedbacks": [
    {
      "id": "demo.equals",
      "name": "値が等しい",
      "options": [
        {
          "id": "key",
          "label": "項目",
          "type": "text",
          "mono": true
        },
        {
          "id": "value",
          "label": "値",
          "type": "text"
        }
      ],
      "compare": {
        "variable": "{{option.key}}",
        "op": "eq",
        "value": "{{option.value}}"
      },
      "summary": "{{option.key}} が {{option.value}}"
    }
  ],
  "variables": [],
  "evidence": [
    {
      "title": "通信しない（アプリ内で値だけ変える）",
      "status": "確認済"
    }
  ],
  "presets": [
    {
      "id": "pgm1",
      "category": "PGM",
      "name": "PGM CAM 1",
      "text": "PGM\nCAM 1",
      "backgroundColor": "#2A2A2E",
      "action": {
        "definitionId": "demo.set",
        "options": {
          "key": "pgm",
          "value": "CAM 1"
        }
      },
      "feedbacks": [
        {
          "definitionId": "demo.equals",
          "options": {
            "key": "pgm",
            "value": "CAM 1"
          },
          "backgroundColor": "#E0302B"
        }
      ]
    },
    {
      "id": "pgm2",
      "category": "PGM",
      "name": "PGM CAM 2",
      "text": "PGM\nCAM 2",
      "backgroundColor": "#2A2A2E",
      "action": {
        "definitionId": "demo.set",
        "options": {
          "key": "pgm",
          "value": "CAM 2"
        }
      },
      "feedbacks": [
        {
          "definitionId": "demo.equals",
          "options": {
            "key": "pgm",
            "value": "CAM 2"
          },
          "backgroundColor": "#E0302B"
        }
      ]
    },
    {
      "id": "pgm3",
      "category": "PGM",
      "name": "PGM CAM 3",
      "text": "PGM\nCAM 3",
      "backgroundColor": "#2A2A2E",
      "action": {
        "definitionId": "demo.set",
        "options": {
          "key": "pgm",
          "value": "CAM 3"
        }
      },
      "feedbacks": [
        {
          "definitionId": "demo.equals",
          "options": {
            "key": "pgm",
            "value": "CAM 3"
          },
          "backgroundColor": "#E0302B"
        }
      ]
    },
    {
      "id": "pgm4",
      "category": "PGM",
      "name": "PGM CAM 4",
      "text": "PGM\nCAM 4",
      "backgroundColor": "#2A2A2E",
      "action": {
        "definitionId": "demo.set",
        "options": {
          "key": "pgm",
          "value": "CAM 4"
        }
      },
      "feedbacks": [
        {
          "definitionId": "demo.equals",
          "options": {
            "key": "pgm",
            "value": "CAM 4"
          },
          "backgroundColor": "#E0302B"
        }
      ]
    },
    {
      "id": "toggle",
      "category": "ON / OFF",
      "name": "ON / OFF",
      "text": "ON/OFF",
      "backgroundColor": "#2A2A2E",
      "action": {
        "definitionId": "demo.toggle",
        "options": {
          "key": "sw1"
        }
      },
      "feedbacks": [
        {
          "definitionId": "demo.equals",
          "options": {
            "key": "sw1",
            "value": "ON"
          },
          "backgroundColor": "#1F5FD6"
        }
      ]
    }
  ]
}
