  "actions": [
    {
      "id": "ch_mute",
      "name": "チャンネルのミュート",
      "options": [
        {
          "id": "ch",
          "label": "チャンネル（1–32）",
          "type": "number",
          "default": 1,
          "min": 1,
          "max": 32
        },
        {
          "id": "mute",
          "label": "ミュート",
          "type": "select",
          "default": "0",
          "choices": [
            {
              "id": "0",
              "label": "ミュートする"
            },
            {
              "id": "1",
              "label": "ミュートを外す"
            }
          ]
        }
      ],
      "send": {
        "kind": "osc",
        "address": "/ch/{{option.ch|pad2}}/mix/on",
        "args": [
          {
            "type": "i",
            "value": "{{option.mute}}"
          }
        ]
      },
      "summary": "CH {{option.ch}} on={{option.mute}}"
    },
