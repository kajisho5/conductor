{
  "format": 1,
  "id": "behringer-x32",
  "name": "Behringer / Midas X32・M32",
  "category": "ミキサー",
  "version": "1.0.0",
  "minAppVersion": "0.6.0",
  "transport": "osc",
  "configFields": [
    {
      "id": "host",
      "label": "IP アドレス",
      "type": "text",
      "placeholder": "192.168.0.64",
      "pattern": "^[A-Za-z0-9.:\\-]+$",
      "mono": true
    },
    {
      "id": "port",
      "label": "ポート",
      "type": "number",
      "default": 10023,
      "min": 1,
      "max": 65535
    }
