        {
          "id": "layer",
          "label": "レイヤー",
          "type": "select",
          "default": "presentation",
          "choices": [
            {
              "id": "presentation",
              "label": "プレゼンテーション"
            },
            {
              "id": "announcement",
              "label": "アナウンス"
            },
            {
              "id": "audio",
              "label": "音声"
            }
          ]
        },
        {
          "id": "sec",
          "label": "秒",
          "type": "number",
          "default": 0,
          "min": 0,
          "max": 86400
