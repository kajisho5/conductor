          "type": "text",
          "default": "1",
          "placeholder": "1"
        }
      ],
      "send": {
        "kind": "http",
        "method": "GET",
        "path": "/v1/clear/group/{{option.id|url}}/trigger"
      },
      "summary": "クリアグループ {{option.id}}"
    },
    {
      "id": "media_next",
      "name": "メディアの次",
      "options": [],
      "send": {
        "kind": "http",
        "method": "GET",
        "path": "/v1/trigger/media/next"
      },
      "summary": "メディア 次"
    },
    {
      "id": "media_previous",
      "name": "メディアの前",
      "options": [],
      "send": {
        "kind": "http",
        "method": "GET",
        "path": "/v1/trigger/media/previous"
      },
      "summary": "メディア 前"
    },
    {
      "id": "media_item",
