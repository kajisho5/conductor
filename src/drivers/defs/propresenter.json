      "send": {
        "kind": "http",
        "method": "GET",
        "path": "/v1/playlist/{{option.to}}/focus"
      },
      "summary": "プレイリスト {{option.to}}"
    },
    {
      "id": "clear_layer",
      "name": "レイヤーを消す",
      "options": [
        {
          "id": "layer",
          "label": "レイヤー",
          "type": "select",
          "default": "slide",
          "choices": [
            {
              "id": "slide",
              "label": "スライド"
            },
            {
              "id": "media",
              "label": "メディア"
            },
            {
              "id": "video_input",
              "label": "ビデオ入力"
            },
            {
              "id": "audio",
              "label": "音声"
            },
            {
              "id": "props",
              "label": "プロップ"
            },
            {
              "id": "messages",
              "label": "メッセージ"
            },
            {
              "id": "announcements",
              "label": "アナウンス"
            }
