    {
      "id": "transport_play",
      "name": "再生（レイヤー）",
      "options": [
        {
          "id": "layer",
          "label": "レイヤー",
          "type": "select",
          "default": "presentation",
          "choices": [
            {
              "id": "presentation",
              "label": "プレゼンテーション"
            },
            {
              "id": "announcement",
              "label": "アナウンス"
