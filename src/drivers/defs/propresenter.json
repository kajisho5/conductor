      "id": "transport_end",
      "name": "最後へ（レイヤー）",
      "options": [
        {
          "id": "layer",
          "label": "レイヤー",
          "type": "select",
          "default": "presentation",
          "choices": [
            {
              "id": "presentation",
              "label": "プレゼンテーション"
            },
            {
              "id": "announcement",
              "label": "アナウンス"
            },
            {
              "id": "audio",
              "label": "音声"
            }
          ]
        }
