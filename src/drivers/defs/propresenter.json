{
  "format": 1,
  "id": "propresenter",
  "name": "ProPresenter 7",
  "category": "プレゼンテーション",
  "version": "1.0.0",
  "minAppVersion": "0.6.0",
  "transport": "http",
  "configFields": [
    {
      "id": "baseUrl",
      "label": "URL の先頭",
      "type": "text",
      "default": "http://192.168.0.10:50001",
      "placeholder": "http://192.168.0.10:50001",
      "pattern": "^https?://.+",
      "mono": true,
      "help": "ProPresenter の設定 > ネットワーク で API を有効にし、そのポートを入れる"
    }
  ],
  "actions": [
    {
      "id": "next",
      "name": "次へ（スライド・項目）",
      "options": [],
      "send": {
        "kind": "http",
        "method": "GET",
        "path": "/v1/trigger/next"
      },
      "summary": "次へ"
    },
    {
      "id": "previous",
      "name": "前へ（スライド・項目）",
      "options": [],
      "send": {
        "kind": "http",
        "method": "GET",
        "path": "/v1/trigger/previous"
      },
      "summary": "前へ"
    },
    {
      "id": "pres_next",
      "name": "プレゼンテーションの次のキュー",
      "options": [
        {
          "id": "which",
          "label": "対象",
          "type": "select",
          "default": "active",
          "choices": [
            {
              "id": "active",
              "label": "再生中"
            },
            {
              "id": "focused",
              "label": "選んでいる"
            }
          ]
        }
      ],
      "send": {
        "kind": "http",
        "method": "GET",
        "path": "/v1/presentation/{{option.which}}/next/trigger"
      },
      "summary": "{{option.which}} 次"
    },
    {
      "id": "pres_previous",
      "name": "プレゼンテーションの前のキュー",
      "options": [
        {
          "id": "which",
          "label": "対象",
          "type": "select",
          "default": "active",
          "choices": [
            {
              "id": "active",
              "label": "再生中"
            },
            {
              "id": "focused",
              "label": "選んでいる"
            }
          ]
        }
      ],
      "send": {
        "kind": "http",
        "method": "GET",
        "path": "/v1/presentation/{{option.which}}/previous/trigger"
      },
      "summary": "{{option.which}} 前"
    },
    {
      "id": "pres_retrigger",
      "name": "プレゼンテーションを最初から",
      "options": [
        {
          "id": "which",
          "label": "対象",
          "type": "select",
          "default": "active",
          "choices": [
            {
              "id": "active",
              "label": "再生中"
            },
            {
              "id": "focused",
              "label": "選んでいる"
            }
          ]
        }
      ],
      "send": {
        "kind": "http",
        "method": "GET",
        "path": "/v1/presentation/{{option.which}}/trigger"
      },
      "summary": "{{option.which}} 最初から"
    },
    {
      "id": "pres_index",
      "name": "プレゼンテーションのキューを指定",
      "options": [
        {
          "id": "which",
          "label": "対象",
          "type": "select",
          "default": "active",
          "choices": [
            {
              "id": "active",
              "label": "再生中"
            },
            {
              "id": "focused",
              "label": "選んでいる"
            }
          ]
        },
        {
          "id": "index",
          "label": "キューの番号（0 から）",
          "type": "number",
          "default": 0,
          "min": 0,
          "max": 9999
        }
      ],
      "send": {
        "kind": "http",
        "method": "GET",
        "path": "/v1/presentation/{{option.which}}/{{option.index}}/trigger"
      },
      "summary": "{{option.which}} キュー {{option.index}}"
    },
    {
      "id": "pres_group",
      "name": "プレゼンテーションのグループ",
      "options": [
        {
          "id": "which",
          "label": "対象",
          "type": "select",
          "default": "active",
          "choices": [
            {
              "id": "active",
              "label": "再生中"
            },
            {
              "id": "focused",
              "label": "選んでいる"
            }
          ]
        },
        {
          "id": "group",
          "label": "グループの名前・番号・UUID",
          "type": "text",
          "default": "Chorus",
          "placeholder": "Chorus"
        }
      ],
      "send": {
        "kind": "http",
        "method": "GET",
        "path": "/v1/presentation/{{option.which}}/group/{{option.group|url}}/trigger"
      },
      "summary": "グループ {{option.group}}"
    },
    {
      "id": "pres_uuid",
      "name": "プレゼンテーションを指定して出す",
      "options": [
        {
          "id": "uuid",
          "label": "プレゼンテーション（UUID・名前）",
          "type": "text",
          "default": "",
          "placeholder": "DEMO-PRESENTATION"
        },
        {
          "id": "index",
          "label": "キューの番号（0 から）",
          "type": "number",
          "default": 0,
          "min": 0,
          "max": 9999
        }
      ],
      "send": {
        "kind": "http",
        "method": "GET",
        "path": "/v1/presentation/{{option.uuid|url}}/{{option.index}}/trigger"
      },
      "summary": "{{option.uuid}} {{option.index}}"
    },
    {
      "id": "library_trigger",
      "name": "ライブラリのプレゼンテーション",
      "options": [
        {
          "id": "lib",
          "label": "ライブラリ",
          "type": "text",
          "default": "",
          "placeholder": "DEMO-LIBRARY"
        },
        {
          "id": "pres",
          "label": "プレゼンテーション",
          "type": "text",
          "default": "",
          "placeholder": "DEMO-SONG"
        },
        {
          "id": "index",
          "label": "キューの番号（0 から）",
          "type": "number",
          "default": 0,
          "min": 0,
          "max": 9999
        }
      ],
      "send": {
        "kind": "http",
        "method": "GET",
        "path": "/v1/library/{{option.lib|url}}/{{option.pres|url}}/{{option.index}}/trigger"
      },
      "summary": "{{option.lib}} / {{option.pres}}"
    },
    {
      "id": "pres_focus",
      "name": "プレゼンテーションを選ぶ",
      "options": [
        {
          "id": "to",
          "label": "対象",
          "type": "select",
          "default": "next",
          "choices": [
            {
              "id": "next",
              "label": "次"
            },
            {
              "id": "previous",
              "label": "前"
            },
            {
              "id": "active",
              "label": "再生中"
            }
          ]
        }
      ],
      "send": {
        "kind": "http",
        "method": "GET",
        "path": "/v1/presentation/{{option.to}}/focus"
      },
      "summary": "選ぶ {{option.to}}"
    },
    {
      "id": "pres_timeline",
      "name": "タイムライン",
      "options": [
        {
          "id": "which",
          "label": "対象",
          "type": "select",
          "default": "active",
          "choices": [
            {
              "id": "active",
              "label": "再生中"
            },
            {
              "id": "focused",
              "label": "選んでいる"
            }
          ]
        },
        {
          "id": "op",
          "label": "操作",
          "type": "select",
          "default": "play",
          "choices": [
            {
              "id": "play",
              "label": "再生"
            },
            {
              "id": "pause",
              "label": "一時停止"
            },
            {
              "id": "rewind",
              "label": "巻き戻し"
            }
          ]
        }
      ],
      "send": {
        "kind": "http",
        "method": "GET",
        "path": "/v1/presentation/{{option.which}}/timeline/{{option.op}}"
      },
      "summary": "タイムライン {{option.op}}"
    },
    {
      "id": "playlist_next",
      "name": "プレイリストの次の項目",
      "options": [],
      "send": {
        "kind": "http",
        "method": "GET",
        "path": "/v1/playlist/focused/next/trigger"
      },
      "summary": "プレイリスト 次"
    },
    {
      "id": "playlist_previous",
      "name": "プレイリストの前の項目",
      "options": [],
      "send": {
        "kind": "http",
        "method": "GET",
        "path": "/v1/playlist/focused/previous/trigger"
      },
      "summary": "プレイリスト 前"
    },
    {
      "id": "playlist_index",
      "name": "プレイリストの項目を指定",
      "options": [
        {
          "id": "pl",
          "label": "プレイリスト（名前・番号・UUID）",
          "type": "text",
          "default": "",
          "placeholder": "DEMO-PLAYLIST"
        },
        {
          "id": "index",
          "label": "キューの番号（0 から）",
          "type": "number",
          "default": 0,
          "min": 0,
          "max": 9999
        }
      ],
      "send": {
        "kind": "http",
        "method": "GET",
        "path": "/v1/playlist/{{option.pl|url}}/{{option.index}}/trigger"
      },
      "summary": "{{option.pl}} の {{option.index}}"
    },
    {
      "id": "playlist_focus",
      "name": "プレイリストを選ぶ",
      "options": [
        {
          "id": "to",
          "label": "対象",
          "type": "select",
          "default": "next",
          "choices": [
            {
              "id": "next",
              "label": "次"
            },
            {
              "id": "previous",
              "label": "前"
            }
          ]
