{
  "format": 1,
  "id": "resolume",
  "name": "Resolume Arena / Avenue",
  "category": "メディアサーバー",
  "version": "1.0.0",
  "minAppVersion": "0.6.0",
  "transport": "osc",
  "configFields": [
    {
      "id": "host",
      "label": "IP アドレス",
      "type": "text",
      "placeholder": "192.168.0.80",
      "pattern": "^[A-Za-z0-9.:\\-]+$",
      "mono": true
    },
    {
      "id": "port",
      "label": "ポート（Resolume の設定 > OSC の入力）",
      "type": "number",
      "default": 7000,
      "min": 1,
      "max": 65535
    }
  ],
  "actions": [
    {
      "id": "clip_connect",
      "name": "クリップを出す",
      "options": [
        {
          "id": "layer",
          "label": "レイヤー",
          "type": "number",
          "default": 1,
          "min": 1,
          "max": 100
        },
        {
          "id": "column",
          "label": "列（クリップ）",
          "type": "number",
          "default": 1,
          "min": 1,
          "max": 1000
        }
      ],
      "send": {
        "kind": "osc",
        "address": "/composition/layers/{{option.layer}}/clips/{{option.column}}/connect",
        "args": [
          {
            "type": "i",
            "value": "1"
          }
        ]
      },
      "more": [
        {
          "kind": "osc",
          "address": "/composition/layers/{{option.layer}}/clips/{{option.column}}/connect",
          "args": [
            {
              "type": "i",
              "value": "0"
            }
          ]
        }
      ],
      "summary": "レイヤー {{option.layer}} クリップ {{option.column}}"
    },
    {
      "id": "clip_select",
      "name": "クリップを選ぶ",
      "options": [
        {
          "id": "layer",
          "label": "レイヤー",
          "type": "number",
          "default": 1,
          "min": 1,
          "max": 100
        },
        {
          "id": "column",
          "label": "列（クリップ）",
          "type": "number",
          "default": 1,
          "min": 1,
          "max": 1000
        }
      ],
      "send": {
        "kind": "osc",
        "address": "/composition/layers/{{option.layer}}/clips/{{option.column}}/select",
        "args": [
          {
            "type": "i",
            "value": "1"
          }
        ]
      },
      "summary": "選ぶ {{option.layer}}-{{option.column}}"
    },
    {
      "id": "column_connect",
