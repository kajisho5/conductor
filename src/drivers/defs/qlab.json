{
  "format": 1,
  "id": "qlab",
  "name": "QLab 5",
  "category": "ショーコントロール",
  "version": "1.0.0",
  "minAppVersion": "0.6.0",
  "transport": "osc",
  "configFields": [
    {
      "id": "host",
      "label": "IP アドレス",
      "type": "text",
      "placeholder": "192.168.10.70",
      "pattern": "^[A-Za-z0-9.:\\-]+$",
      "mono": true
    },
    {
      "id": "port",
      "label": "ポート",
      "type": "number",
      "default": 53000,
      "min": 1,
      "max": 65535
    },
    {
      "id": "prefix",
      "label": "宛先のワークスペース",
      "type": "text",
      "default": "",
      "placeholder": "/workspace/DEMO-SHOW",
      "mono": true,
      "pattern": "^(/workspace/[^\\s/]+)?$",
      "help": "空ならすべてのワークスペース。1 つに絞る時は /workspace/名前（名前は空白なし・.qlab5 を付けない）"
    }
  ],
  "actions": [
    {
      "id": "go",
      "name": "GO",
      "options": [],
      "send": {
        "kind": "osc",
        "address": "{{config.prefix}}/go",
        "args": []
      },
      "summary": "GO"
    },
    {
      "id": "go_cue",
      "name": "キューから GO",
      "options": [
        {
          "id": "cue",
          "label": "キュー番号",
          "type": "text",
          "default": "1",
          "placeholder": "1"
        }
      ],
      "send": {
        "kind": "osc",
        "address": "{{config.prefix}}/go",
        "args": [
          {
            "type": "s",
            "value": "{{option.cue}}"
          }
        ]
      },
      "summary": "GO {{option.cue}}"
    },
    {
      "id": "stop",
      "name": "すべて停止",
      "options": [],
      "send": {
        "kind": "osc",
        "address": "{{config.prefix}}/stop",
        "args": []
      },
      "summary": "停止"
    },
    {
      "id": "pause",
      "name": "すべて一時停止",
      "options": [],
      "send": {
        "kind": "osc",
        "address": "{{config.prefix}}/pause",
        "args": []
      },
      "summary": "一時停止"
    },
    {
      "id": "resume",
      "name": "すべて再開",
      "options": [],
      "send": {
        "kind": "osc",
        "address": "{{config.prefix}}/resume",
        "args": []
      },
      "summary": "再開"
    },
    {
      "id": "panic",
      "name": "パニック",
      "options": [],
      "send": {
        "kind": "osc",
        "address": "{{config.prefix}}/panic",
        "args": []
      },
      "summary": "パニック"
    },
    {
      "id": "panic_in_time",
      "name": "パニック（時間を決めて）",
      "options": [
        {
          "id": "sec",
          "label": "秒",
          "type": "number",
          "default": 2,
          "min": 0,
          "max": 600
        }
      ],
      "send": {
        "kind": "osc",
        "address": "{{config.prefix}}/panicInTime",
        "args": [
          {
            "type": "f",
            "value": "{{option.sec}}"
          }
        ]
      },
      "summary": "パニック {{option.sec}} 秒"
    },
    {
      "id": "hard_stop",
