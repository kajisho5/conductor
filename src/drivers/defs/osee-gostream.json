    {
      "title": "枠（先頭 EB A6・種別・長さ・JSON・CRC-16/MODBUS）とポート 19010",
      "status": "確認済",
      "note": "公開 OSS のモジュール osee-gostream-series（MIT）を conductor-drivers の Actions で動かして記録した送信と一致",
      "url": "https://github.com/bitfocus/companion-module-osee-gostream-series"
    },
    {
      "title": "命令の id と値の形（pgmIndex・cutTransition・keyOnAir など）",
      "status": "推測",
      "note": "オーナーの別アプリ kajisho5/osee_control_software（同じ OSS と各機種の説明書が根拠。Duet 8 ISO の実機で使用）の実装から写した。KEY は true / false、DSK は 1 / 0（cutline と同じ）。機器の画面の「最近のログ」（詳細）で送受信を確かめる"
    },
    {
      "title": "PTZ・スチルを撮る は Omni 12 ISO のみ。FTB は Duet 8 ISO ではファームウェア 2.1.0 以降",
      "status": "推測",
      "note": "cutline の deviceProfiles と説明書"
    }
  ]
